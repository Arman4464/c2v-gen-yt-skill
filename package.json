{
  "name": "c2v-gen-yt-skill",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion + Three.js 2.5D cel-shaded cartoon short generator (Ricks Clips style)",
  "type": "module",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render src/index.ts RicksClipsFull out/video.mp4",
    "render:showcase": "remotion render src/index.ts RicksClipsShowcase out/showcase.mp4",
    "render:demo": "remotion render src/index.ts RicksClipsDemo out/demo.mp4",
    "still": "remotion still src/index.ts RicksClipsFull out/frame.png",
    "check": "tsc --noEmit",
    "tts": "python scripts/gemini_tts.py"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "^4.0.543",
    "@remotion/media-utils": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "@remotion/three": "^4.0.543",
    "@types/three": "^0.187.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
